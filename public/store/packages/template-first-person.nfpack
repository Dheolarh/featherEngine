              "bindings": [],
              "children": [
                {
                  "id": "uiel-90f41adf-b9bd-4b5c-86bc-40603b68c038",
                  "kind": "text",
                  "name": "Tip Header",
                  "text": "Deploy",
                  "style": {
                    "color": "#ff2bd6",
                    "fontSize": "13px",
