            "data": {
              "label": "Set Object Var: lightOn",
              "category": "Variables",
              "nodeKind": "variable.setObject",
              "objectKey": "lightOn",
              "description": "Writes an instance variable on the target object (self by default; set targetObjectId / \"$trigger\" to write the toucher).",
              "tone": "variable",
              "hasInput": true,
              "hasOutput": true
            }
          },
          {
            "id": "node-f9f34eee-2714-4481-babb-71109c9ecbd3",
            "type": "nodeforge",
            "position": {
              "x": 308,
              "y": 220
            },
            "data": {
              "label": "Set Active On",
              "category": "Runtime",
              "nodeKind": "action.setActive",
              "targetObjectId": "obj-92e09bbb-0741-40df-9d88-419f30bf0145",
              "description": "Fully activates or deactivates the owner (or Target). OFF = the object stops rendering, stops running its script, drops its physics collider, and is ignored by AI/Find — like switching it off. ON = back to normal. Use for doors/hazards/spawned enemies you toggle. Stronger than Set Visible (which only hides the mesh). Wire a Boolean into \"on\", or set it on the node.",
              "tone": "runtime",
              "hasInput": true,
              "hasOutput": true
            }
          },
          {
            "id": "node-53c3da39-acfb-4b54-b191-97d42a7fb520",
