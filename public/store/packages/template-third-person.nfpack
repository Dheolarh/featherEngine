              "x": 156,
              "y": 220
            },
            "data": {
              "label": "Interact",
              "category": "Events",
              "nodeKind": "event.interact",
              "description": "Fires when the player presses the interact key while focused on this object (Unreal-style). Mark the object interactable with an \"interactable\" instance variable; an \"interactPrompt\" variable sets the on-screen label.",
              "tone": "event",
              "hasInput": false,
              "hasOutput": true
            }
          },
          {
            "id": "node-b557e2b4-6b09-4992-acea-12f603d9b5b1",
            "type": "nodeforge",
            "position": {
              "x": 194,
              "y": 220
            },
            "data": {
              "label": "Set Ragdoll On",
              "category": "Runtime",
              "nodeKind": "action.setRagdoll",
              "targetObjectId": "obj-544d15bd-6dc5-4499-a929-182785b9c48e",
              "booleanValue": true,
              "description": "Switches the owner (or Target) into a physics ragdoll — bones go limp.",
              "tone": "runtime",
              "hasInput": true,
              "hasOutput": true
            }
          },
          {
            "id": "node-68cc78a9-d6eb-468d-ad29-d9f24664b499",
            "type": "nodeforge",
            "position": {
              "x": 232,
              "y": 220
            },
            "data": {
              "label": "Camera Shake 0.22",
              "category": "Runtime",
              "nodeKind": "action.cameraShake",
              "shakeAmount": 0.22,
              "description": "Shakes the player camera (trauma 0..1, fades automatically) — explosions, big hits, impacts. The player firing/taking damage already adds shake; use this node for scripted punch.",
              "tone": "runtime",
