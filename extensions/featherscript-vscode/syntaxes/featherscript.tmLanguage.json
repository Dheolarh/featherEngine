{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FeatherScript",
  "scopeName": "source.featherscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#blueprint-declaration" },
    { "include": "#function-declaration" },
    { "include": "#event-declaration" },
    { "include": "#variable-declaration" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#namespaces" },
    { "include": "#named-arguments" },
    { "include": "#function-calls" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.featherscript",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.featherscript" }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.featherscript",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.featherscript" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.featherscript" }
          },
          "patterns": [
            { "name": "constant.character.escape.featherscript", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.featherscript",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.featherscript" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.featherscript" }
          },
          "patterns": [
            { "name": "constant.character.escape.featherscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "blueprint-declaration": {
      "patterns": [
        {
          "match": "^(\\s*)(blueprint)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "storage.type.class.featherscript" },
            "3": { "name": "entity.name.type.class.featherscript" }
          }
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "^(\\s*)(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "storage.type.function.featherscript" },
            "3": { "name": "entity.name.function.featherscript" }
          }
        }
      ]
    },
    "event-declaration": {
      "patterns": [
        {
          "match": "^(\\s*)(on)\\s+(?:(event)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "keyword.control.event.featherscript" },
            "3": { "name": "storage.modifier.event.featherscript" },
            "4": { "name": "entity.name.function.event.featherscript" }
          }
        }
      ]
    },
    "variable-declaration": {
      "patterns": [
        {
          "match": "^(\\s*)(var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "storage.type.variable.featherscript" },
            "3": { "name": "variable.other.readwrite.featherscript" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.featherscript",
          "match": "\\b(?:number|string|boolean|vector3)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.featherscript",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.featherscript",
          "match": "\\b(?:none|null)\\b"
        },
        {
          "name": "variable.language.featherscript",
          "match": "\\b(?:self|other|player|dt|cast_actor)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.featherscript",
          "match": "\\b(?:if|elif|else|for|in|while|match|case|default|then|sequence|sync|race|flip_flop|detached|return|pass)\\b"
        },
        {
          "name": "keyword.operator.logical.featherscript",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "support.class.featherscript",
          "match": "\\b(?:Game|Input|Player|AI|UI|Save|Audio|Scene|Camera|Screen|Animator)(?=\\.)"
        }
      ]
    },
    "named-arguments": {
      "patterns": [
        {
          "name": "variable.parameter.featherscript",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "support.function.featherscript",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.featherscript",
          "match": "(?<![A-Za-z0-9_])(?:0[xX][0-9A-Fa-f]+|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)(?:ms|s)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.featherscript",
          "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*\\/%=<>]"
        }
      ]
    }
  }
}
