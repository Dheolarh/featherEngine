{
  "Blueprint file": {
    "prefix": "blueprint",
    "description": "Create a FeatherScript blueprint with a start event",
    "body": [
      "blueprint ${1:Player}",
      "",
      "on start:",
      "    ${0:print(\"Ready\")}"
    ]
  },
  "Start event": {
    "prefix": "on start",
    "description": "Run once when the Blueprint starts",
    "body": [
      "on start:",
      "    ${0:pass}"
    ]
  },
  "Update event": {
    "prefix": "on update",
    "description": "Run every frame",
    "body": [
      "on update(dt):",
      "    ${0:pass}"
    ]
  },
  "Timed update event": {
    "prefix": "on update every",
    "description": "Run Update on an interval",
    "body": [
      "on update every ${1:1s}:",
      "    ${0:pass}"
    ]
  },
  "Keyboard event": {
    "prefix": "on key",
    "description": "Handle a held keyboard key",
    "body": [
      "on key_down(\"${1:KeyW}\"):",
      "    ${0:pass}"
    ]
  },
  "Collision event": {
    "prefix": "on collision",
    "description": "Handle a new collision",
    "body": [
      "on collision_enter(other):",
      "    ${0:pass}"
    ]
  },
  "Custom event": {
    "prefix": "on event",
    "description": "Handle a custom event",
    "body": [
      "on event ${1:CustomEvent}(${2:payload}):",
      "    ${0:pass}"
    ]
  },
  "Number variable": {
    "prefix": "var number",
    "body": "var ${1:health}: number = ${2:100}",
    "description": "Declare a number variable"
  },
  "String variable": {
    "prefix": "var string",
    "body": "var ${1:name}: string = \"${2:Player}\"",
    "description": "Declare a string variable"
  },
  "Boolean variable": {
    "prefix": "var boolean",
    "body": "var ${1:enabled}: boolean = ${2:true}",
    "description": "Declare a boolean variable"
  },
  "Vector variable": {
    "prefix": "var vector3",
    "body": "var ${1:direction}: vector3 = vec3(${2:0}, ${3:0}, ${4:1})",
    "description": "Declare a vector3 variable"
  },
  "Function": {
    "prefix": "function",
    "description": "Declare a FeatherScript function",
    "body": [
      "function ${1:name}(${2:argument}):",
      "    ${0:pass}"
    ]
  },
  "If block": {
    "prefix": "if",
    "description": "Create a conditional block",
    "body": [
      "if ${1:condition}:",
      "    ${0:pass}"
    ]
  },
  "If / else block": {
    "prefix": "if else",
    "description": "Create a conditional with a fallback",
    "body": [
      "if ${1:condition}:",
      "    ${2:pass}",
      "else:",
      "    ${0:pass}"
    ]
  },
  "Range loop": {
    "prefix": "for range",
    "description": "Repeat a block a fixed number of times",
    "body": [
      "for ${1:index} in range(${2:5}):",
      "    ${0:pass}"
    ]
  }
}
